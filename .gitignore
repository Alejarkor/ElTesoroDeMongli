# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]ser[Ss]ettings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Optional Asset Store tools plugin
# /[Aa]ssets/AssetStoreTools*

# IDE and editor caches
.vs/
.vscode/
.idea/
[Aa]ssets/Plugins/Editor/JetBrains*

# Gradle cache
.gradle/

# Autogenerated solution/project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files for debug symbols
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt

# Build outputs
*.apk
*.aab
*.unitypackage
*.app

# OS generated files
.DS_Store
Thumbs.db

# Crashlytics generated file
crashlytics-build.properties
